# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# URL pública donde queda montada la app (tu dominio). Sin barra final.
NEXT_PUBLIC_APP_URL=https://tudominio.com

# Canal por defecto del código de ingreso: "whatsapp" (recomendado) o "sms".
# El usuario igual puede elegir el otro canal en la pantalla de login.
# En desarrollo local sin remitente de WhatsApp configurado, usar "sms".
NEXT_PUBLIC_DEFAULT_OTP_CHANNEL=whatsapp

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo servidor. NUNCA exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Solo servidor. Permite loguear directo (sin OTP) a jugadores que un admin
# cargo a mano, mientras no hay WhatsApp/SMS conectado. Cualquier string
# largo al azar sirve (no hace falta recordarlo ni compartirlo).
PLAYER_AUTO_LOGIN_SECRET=cambia-esto-por-un-string-largo-aleatorio

# ---------------------------------------------------------------------------
# Edge Function de recordatorios (se configuran con `supabase secrets set`)
# ---------------------------------------------------------------------------
# Proveedor de mensajería para SMS / WhatsApp. Dejar vacío para modo "log".
NOTIFY_PROVIDER=log            # log | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Token compartido para que pg_cron pueda invocar la función de recordatorios.
REMINDERS_CRON_SECRET=cambia-esto-por-un-string-largo-aleatorio
